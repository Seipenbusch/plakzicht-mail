# Kopieer naar .env in de stackmap van Compose Manager Plus en pas aan.
# live = de vrijgegeven versie (Actions › Versie vrijgeven). test = elke nieuwe versie na samenvoegen in main.
KANAAL=live
# Poort op Unraid voor het lokale adres (http://<ip-van-unraid>:8765)
POORT=8765
# Gegevensmap (database, config.json, secrets.key, back-ups)
DATA_MAP=/mnt/user/appdata/plakzicht-mail
# Cloudflare Tunnel voor mail.plakzicht.nl: haal de twee # weg en vul het token in
#COMPOSE_PROFILES=tunnel
#TUNNEL_TOKEN=
# Icoon in het Docker-overzicht van Unraid (vul het IP-adres van Unraid in)
#ICON_URL=http://192.168.1.10:8765/icons/icon-192.png
